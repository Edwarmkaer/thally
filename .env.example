# Convex — valores reales los da `bunx convex dev` (deployment dev:charming-impala-642)
CONVEX_DEPLOYMENT=
CONVEX_URL=
CONVEX_SITE_URL=
# La app cliente solo lee esta (misma URL que CONVEX_URL)
NEXT_PUBLIC_CONVEX_URL=

# Clerk — `npx clerk@latest init` las escribe solo en .env.local
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# GitHub — abrir issues desde una afirmación (convex env set GITHUB_TOKEN ...)
# Token fine-grained con permiso "Issues: read & write" sobre el repo destino.
GITHUB_TOKEN=
GITHUB_REPO=Edwarmkaer/thally

# ElevenLabs Scribe — transcripción del contenido hablado (scripts/*-realtime.ts)
ELEVENLABS_API_KEY=

# --- Variables del deployment de Convex, NO de este archivo -------------------
# Las siguientes las lee el servidor de Convex, no Next. Se cargan con
# `bunx convex env set <NOMBRE> <valor>` y se listan con `bunx convex env list`.
# Se documentan aquí para que se sepa que existen; dejarlas en .env.local no sirve.
#
#   AGENT_WEBHOOK_SECRET   Bearer que autentica /agent/* en convex/http.ts
#   APIFY_TOKEN            actor apify/rag-web-browser, búsqueda de evidencia
#   ANTHROPIC_API_KEY      detector de afirmaciones y evaluador de evidencia
#   GITHUB_TOKEN           abrir issues desde una afirmación
#   GITHUB_REPO            repo destino de esas issues
